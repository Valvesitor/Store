{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "store-test",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2025-11-01",
  "routes": [
    {
      "pattern": "thewantedsolestudio.com/api/*",
      "zone_name": "thewantedsolestudio.com"
    },
    {
      "pattern": "www.thewantedsolestudio.com/api/*",
      "zone_name": "thewantedsolestudio.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "TEBEX_PUBLIC_TOKEN": "132na-1c1984f72b78f7b52212dfbea35543ccb051bb66",
    "SITE_BASE_URL": "https://thewantedsolestudio.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tws_store_db",
      "database_id": "d305422f-2527-4d95-ae7d-a16c4f8bf968"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_MEDIA",
      "bucket_name": "tws-product-assets"
    }
  ]
}
